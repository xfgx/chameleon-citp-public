FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY mobilecore ./mobilecore
RUN GOOS=linux go build -trimpath -ldflags "-s -w" -o /out/cham-server ./cmd/cham-server \
 && GOOS=linux go build -trimpath -ldflags "-s -w" -o /out/cham-keygen ./cmd/cham-keygen

FROM debian:bookworm-slim
COPY --from=build /out/cham-server /usr/local/bin/cham-server
COPY --from=build /out/cham-keygen /usr/local/bin/cham-keygen
COPY test/e2e/server-init.sh /usr/local/bin/server-init.sh
RUN chmod +x /usr/local/bin/server-init.sh
ENTRYPOINT ["/usr/local/bin/server-init.sh"]
